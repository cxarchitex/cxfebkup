<div id="custom-chat-root">
  <!-- Chat Bubble -->
  <button
    id="chat-toggle"
    type="button"
    aria-label="Open chat"
  >
    Chat
  </button>

  <!-- Chat Window -->
  <div id="chat-window" class="hidden">
    <div class="chat-header">
      <span>Support</span>
      <button
        id="chat-close"
        type="button"
        aria-label="Close chat"
      >
        ×
      </button>
    </div>

    <div class="chat-messages" data-chat-messages>
      <div class="chat-msg bot">
        Hi 👋 I can help with tracking orders, listing orders, or checking products.
      </div>
    </div>

    <div class="chat-input">
      <input
        type="text"
        placeholder="Type your message..."
        data-chat-input
      />
      <button
        type="button"
        data-chat-send
        aria-label="Send message"
      >
        ▶
      </button>
    </div>
  </div>
</div>

<!-- Shopify customer context -->
<script>
  window.SHOPIFY_CUSTOMER = {
    id: {{ customer.id | default: 'null' }},
    email: {{ customer.email | json }}
  };
</script>

<!-- Toggle logic -->
<script>
  (function () {
    const toggleBtn = document.getElementById("chat-toggle");
    const closeBtn = document.getElementById("chat-close");
    const chatWindow = document.getElementById("chat-window");

    if (!toggleBtn || !closeBtn || !chatWindow) return;

    toggleBtn.addEventListener("click", () => {
      chatWindow.classList.remove("hidden");
      toggleBtn.classList.add("hidden");
    });

    closeBtn.addEventListener("click", () => {
      chatWindow.classList.add("hidden");
      toggleBtn.classList.remove("hidden");
    });
  })();
</script>
