<!-- Chat Toggle Button -->
<button id="cx-chat-toggle">Chat</button>

<!-- Chat Widget -->
<div id="cx-chat-root" class="cx-hidden">
  <div class="cx-chat-header">
    <span>Support</span>
    <button id="cx-chat-close">×</button>
  </div>

  <div id="cx-chat-messages"></div>

  <div class="cx-chat-input">
    <input
      id="cx-chat-input"
      type="text"
      placeholder="Type your message..."
      autocomplete="off"
    />
    <button id="cx-chat-send">➤</button>
  </div>
</div>
