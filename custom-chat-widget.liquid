<div class="chat-launcher" data-chat-launcher>
  Chat
</div>

<div class="chat-widget" data-chat-widget>
  <div class="chat-header">
    <span>Support</span>
    <button data-chat-close>×</button>
  </div>

  <div class="chat-messages" data-chat-messages></div>

  <div class="chat-input">
    <input type="text" placeholder="Type your message..." data-chat-input />
    <button data-chat-send>➤</button>
  </div>
</div>
